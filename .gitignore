# ============================================================================
# Project data — large rasters/vectors live outside git
# ============================================================================

# raw downloads (from GEE, NRCan, PCIC, etc.)
data/raw/**
!data/raw/.gitkeep

# intermediate / derived rasters
data/processed/**
!data/processed/.gitkeep

# figure / table / shapefile outputs (regenerated from scripts)
output/figures/**
!output/figures/.gitkeep
output/tables/**
!output/tables/.gitkeep
output/shapefiles/**
!output/shapefiles/.gitkeep

# GEE-side downloads sometimes land here
*.tif
*.tiff
*.nc
*.hdf
*.zip
*.7z

# but always keep the small JS scripts
!gee/*.js

# rendered report outputs
report/*.html
report/*.pdf
technical_report/*.html
technical_report/*.pdf


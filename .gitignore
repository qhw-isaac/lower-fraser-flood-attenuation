.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Rproj.user/
.httr-oauth
.Renviron
*-Ex.R
/*.tar.gz
/*.Rcheck/

# knitr / rmarkdown caches
*_cache/
/cache/
*.utf8.md
*.knit.md
vignettes/*.html
vignettes/*.pdf
docs/

# pkgdown / Shiny
rsconnect/
po/*~

# ============================================================================
# OS / IDE
# ============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ============================================================================
# Project data — large rasters/vectors live outside git
# ============================================================================

# raw downloads (from GEE, NRCan, PCIC, etc.)
data/raw/**
!data/raw/.gitkeep

# intermediate / derived rasters
data/processed/**
!data/processed/.gitkeep

# terra scratch space (spilled intermediate rasters; cleared per session)
data/tmp/

# figure / table / shapefile outputs (regenerated from scripts)
output/figures/**
!output/figures/.gitkeep
output/tables/**
!output/tables/.gitkeep
output/shapefiles/**
!output/shapefiles/.gitkeep

# GEE-side downloads sometimes land here
*.tif
*.tiff
*.nc
*.hdf
*.zip
*.7z

# but always keep the small JS scripts
!gee/*.js

# ============================================================================
# Reference material (large PDFs the user provided locally for context)
# ============================================================================
Context/
technical_report/
lookup/

# temp hide
output/interactive_map/README.md